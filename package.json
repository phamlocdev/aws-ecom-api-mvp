{
  "name": "dynamodb-ecommerce-learning",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS e-commerce MVP for learning DynamoDB on AWS",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "infra:synth": "node scripts/run-cdk.js synth",
    "infra:synth:client": "node scripts/run-cdk.js synth ClientDevStack",
    "infra:bootstrap": "node scripts/run-cdk.js bootstrap",
    "infra:deploy": "npm run client:hosting:env:sync:optional && node scripts/run-cdk.js deploy --require-approval never --outputs-file aws-outputs.json && npm run client:env:sync",
    "infra:deploy:client": "npm run client:env:sync && npm --prefix ../client run build && node scripts/run-cdk.js deploy ClientDevStack --require-approval never --outputs-file client-outputs.json && npm run client:hosting:env:sync",
    "infra:destroy": "node scripts/run-cdk.js destroy --force",
    "seed:catalog": "npx ts-node src/scripts/seed-catalog.ts",
    "seed:users": "npx ts-node src/scripts/seed-users.ts",
    "seed:user-accounts": "npx ts-node src/scripts/seed-user-accounts.ts",
    "seed:user-access": "npx ts-node src/scripts/seed-user-access.ts",
    "seed:all": "npm run seed:catalog && npm run seed:users",
    "simulate:oversell": "npx ts-node src/scripts/simulate-oversell.ts",
    "test:order-audit-log": "npx ts-node src/scripts/test-order-audit-log.ts",
    "test:notification-retry": "npx ts-node src/scripts/test-notification-retry-flows.ts",
    "test:client-rewrite": "npx ts-node src/scripts/test-client-rewrite.ts",
    "seo:backfill:products": "npx ts-node src/scripts/backfill-product-seo-pages.ts",
    "client:env:sync": "npx ts-node src/scripts/sync-client-env.ts",
    "client:hosting:env:sync": "npx ts-node src/scripts/sync-client-hosting-env.ts",
    "client:hosting:env:sync:optional": "npx ts-node src/scripts/sync-client-hosting-env.ts --optional",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md,yml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,yml}\""
  },
  "dependencies": {
    "@aws-crypto/client-node": "^5.0.2",
    "@aws-sdk/client-cloudfront": "^3.1136.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1107.0",
    "@aws-sdk/client-dynamodb": "^3.1107.0",
    "@aws-sdk/client-eventbridge": "^3.1120.0",
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/client-secrets-manager": "^3.1107.0",
    "@aws-sdk/client-sesv2": "^3.1120.0",
    "@aws-sdk/client-sqs": "^3.1107.0",
    "@aws-sdk/lib-dynamodb": "^3.1107.0",
    "@aws-sdk/s3-presigned-post": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@codegenie/serverless-express": "^4.17.1",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "aws-jwt-verify": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.4.2",
    "handlebars": "^4.7.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "vnpay": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewayv2": "^3.1107.0",
    "@aws-sdk/client-cloudformation": "^3.1107.0",
    "@aws-sdk/client-lambda": "^3.1107.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "aws-cdk": "^2.1136.0",
    "aws-cdk-lib": "^2.264.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
